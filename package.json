{
  "name": "tshet-uinh",
  "version": "0.16.0-beta.8",
  "description": "A JavaScript library for the Qieyun phonological system",
  "type": "module",
  "main": "./dist/tshet-uinh.cjs",
  "module": "./dist/tshet-uinh.js",
  "exports": {
    ".": {
      "import": "./dist/tshet-uinh.js",
      "require": "./dist/tshet-uinh.cjs"
    }
  },
  "scripts": {
    "prebuild": "python prepare/main.py",
    "prepare": "run-s prebuild build:rollup build:types",
    "build": "run-s prebuild build:*",
    "build:rollup": "rollup -c",
    "build:types": "api-extractor run && bun run fix-dts.js",
    "build:test": "tsc -p tsconfig.test.json",
    "fix": "run-s fix:*",
    "fix:format": "dprint fmt 'src/**/*.ts'",
    "fix:lint": "eslint 'src/**/*.ts' --fix",
    "test": "run-s build test:*",
    "test:format": "dprint check --list-different src/**/*.ts",
    "test:lint": "eslint src",
    "test:unit": "nyc --silent ava",
    "watch:build-tests": "tsc -p tsconfig.test.json -w",
    "watch:test": "nyc --silent ava --watch",
    "cov": "run-s build test:unit cov:html cov:lcov && open-cli coverage/index.html",
    "cov:html": "nyc report --reporter=html",
    "cov:lcov": "nyc report --reporter=lcov",
    "cov:send": "run-s cov:lcov && codecov",
    "cov:check": "nyc report && nyc check-coverage --lines 100 --functions 100 --branches 100",
    "doc": "run-s doc:dev && open-cli docs/index.html",
    "doc:dev": "typedoc src/index.ts",
    "doc:watch": "typedoc src/index.ts --watch",
    "doc:html": "typedoc src/index.ts --plugin ./typedoc_cf_analytics.js",
    "reset-hard": "git clean -dfx && git reset --hard && npm i",
    "prepare-release": "run-s reset-hard test cov:check doc:html"
  },
  "engines": {
    "node": "^20.9 || ^22 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nk2028/tshet-uinh-js.git"
  },
  "keywords": [
    "historical-linguistics",
    "linguistics",
    "middle-chinese",
    "qieyun"
  ],
  "author": "Project NK2028",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nk2028/tshet-uinh-js/issues"
  },
  "homepage": "https://github.com/nk2028/tshet-uinh-js#readme",
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@microsoft/api-extractor": "^7.58.9",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "ajv": "^8.20.0",
    "ava": "^8.0.1",
    "dprint": "^0.54.0",
    "eslint": "^10.5.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "extensionless": "^2.0.6",
    "npm-run-all": "^4.1.5",
    "nyc": "^18.0.0",
    "open-cli": "^9.0.0",
    "rollup": "^4.62.0",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "files": [
    "dist"
  ],
  "ava": {
    "failFast": true,
    "timeout": "60s",
    "typescript": {
      "rewritePaths": {
        "src/": "build/test/"
      },
      "compile": false
    },
    "files": [
      "!build/esnext/**"
    ],
    "nodeArguments": [
      "--import=extensionless/register"
    ]
  },
  "nyc": {
    "extends": "@istanbuljs/nyc-config-typescript",
    "exclude": [
      "**/*.spec.js"
    ]
  }
}
